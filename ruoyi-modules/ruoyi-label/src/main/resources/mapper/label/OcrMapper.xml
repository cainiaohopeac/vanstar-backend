<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.label.mapper.OcrMapper">

    <select id="selectAssetById" resultType="org.dromara.label.ocr.dto.AssetImageRef">
        SELECT file_url AS fileUrl,
               media_type AS mediaType
        FROM label_asset
        WHERE id = #{assetId}
          AND deleted = 0
    </select>

</mapper>
