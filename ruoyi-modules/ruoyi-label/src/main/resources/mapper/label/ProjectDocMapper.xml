<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.label.mapper.ProjectDocMapper">

    <resultMap id="projectDocVOMap" type="org.dromara.label.vo.ProjectDocVO">
        <id property="id" column="id" />
        <result property="projectId" column="project_id" />
        <result property="fileName" column="file_name" />
        <result property="fileSize" column="file_size" />
        <result property="contentType" column="content_type" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="uploadedBy" column="uploaded_by" />
        <result property="uploadedByName" column="uploaded_by_name" />
        <result property="objectName" column="object_name" />
        <result property="bucketName" column="bucket_name" />
    </resultMap>

    <!--
        查询项目当前生效的标注文档（含上传人姓名）。
        对应 service 调用方：ProjectDocController GET 文档接口。
    -->
    <select id="selectDocByProjectId" resultMap="projectDocVOMap">
        SELECT d.id,
               d.project_id,
               d.file_name,
               d.file_size,
               d.content_type,
               d.create_time,
               d.update_time,
               d.created_by AS uploaded_by,
               COALESCE(uploader.nick_name, uploader.user_name, '') AS uploadedByName,
               d.object_name,
               d.bucket_name
        FROM label_project_doc d
        LEFT JOIN sys_user uploader ON uploader.user_id = d.created_by
        WHERE d.deleted = 0 AND d.project_id = #{projectId}
        LIMIT 1
    </select>

    <!-- 读取原始行（删除旧对象时使用，需拿到 objectName/bucketName） -->
    <select id="selectDocRow" resultType="map">
        SELECT object_name, bucket_name
        FROM label_project_doc
        WHERE deleted = 0 AND project_id = #{projectId}
        LIMIT 1
    </select>

    <!-- 插入文档（与 selectDocRow + softDeleteByProjectId 一起实现「按项目单文档覆盖」） -->
    <insert id="insertDoc" parameterType="map" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO label_project_doc (
            project_id, file_name, object_name, bucket_name, file_size, content_type,
            created_by, updated_by, deleted
        ) VALUES (
            #{projectId}, #{fileName}, #{objectName}, #{bucketName}, #{fileSize},
            COALESCE(#{contentType}, 'application/pdf'), #{userId}, #{userId}, 0
        )
    </insert>

    <!-- 按项目物理删除文档行（含已软删历史行）：uk_project_id 是普通 UNIQUE KEY，
         必须真正删除才能释放唯一键，避免覆盖上传时触发唯一键冲突。审计由操作日志承担。 -->
    <delete id="deleteByProjectId">
        DELETE FROM label_project_doc
        WHERE project_id = #{projectId}
    </delete>

</mapper>